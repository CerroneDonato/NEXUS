<?xml version="1.0" encoding="utf-8"?>
<!-- Lilith's orb with the day's orbit and a small sun. Everything stays inside the 66 dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Halo. -->
    <path android:pathData="M54,54m-34,0a34,34 0,1 1,68 0a34,34 0,1 1,-68 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="34">
                <item android:offset="0" android:color="#8CCFE3FF" />
                <item android:offset="1" android:color="#00CFE3FF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Back half of the orbit, behind the orb. -->
    <group android:rotation="-20" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M21,54a33,11 0,0 1,66 0"
            android:strokeWidth="1.6"
            android:strokeColor="#73CFE3FF"
            android:strokeLineCap="round" />
    </group>
    <!-- Orb. -->
    <path android:pathData="M54,54m-17,0a17,17 0,1 1,34 0a17,17 0,1 1,-34 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="48.5"
                android:centerY="47.5"
                android:gradientRadius="22">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.45" android:color="#FFDCEAFF" />
                <item android:offset="1" android:color="#FF7F97C4" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Front half of the orbit and the sun. -->
    <group android:rotation="-20" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M87,54a33,11 0,0 1,-66 0"
            android:strokeWidth="1.8"
            android:strokeColor="#FFEAF2FF"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#FFFFC861"
            android:pathData="M75.2,62.4m-3.8,0a3.8,3.8 0,1 1,7.6 0a3.8,3.8 0,1 1,-7.6 0" />
    </group>
</vector>
