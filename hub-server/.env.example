# Copy to hub-server/.env on the hub PC and fill in. Never commit .env.

# Shared secret used by the dashboard and the Android app (Authorization: Bearer <token>).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
HUB_API_TOKEN=change-me

HUB_HOST=0.0.0.0
HUB_PORT=8765
HUB_TIMEZONE=Europe/Rome

# Milan
WEATHER_LATITUDE=45.4642
WEATHER_LONGITUDE=9.1900
WEATHER_CITY=Milano

# Google Calendar (see docs/google-calendar-setup.md)
GOOGLE_CLIENT_SECRET_FILE=secrets/client_secret.json
GOOGLE_TOKEN_FILE=secrets/google_token.json
# Comma separated calendar IDs; "primary" is your main calendar.
GOOGLE_CALENDAR_IDS=primary

# Wake the PC this many minutes before the phone alarm, so the dashboard is ready when it rings.
WAKE_LEAD_MINUTES=2
# Set to false to disable Windows Task Scheduler integration.
WAKE_ENABLED=true
